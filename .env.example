# korapi — API Gateway (tek dış giriş noktası)
SERVICE_NAME=korapi
HTTP_PORT=8080

# Redis (rate limit + JWKS cache)
REDIS_URL=redis://localhost:6379/1

# Downstream servis adresleri (yalnız iç ağdan erişilir)
KORAUTH_URL=http://korauth:8081
KORVM_URL=http://korvm:8082
KORVOL_URL=http://korvol:8083

# korauth JWKS endpoint (token doğrulama için)
JWKS_URL=http://localhost:8081/v1/auth/.well-known/jwks.json
JWKS_CACHE_TTL=10m

# Rate limit (tenant/IP başına, sliding window)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

LOG_LEVEL=info
