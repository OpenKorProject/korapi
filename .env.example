# korapi — API Gateway (single external entry point)
SERVICE_NAME=korapi
HTTP_PORT=8080

# Redis (rate limiting + JWKS cache)
REDIS_URL=redis://localhost:6379/1

# Downstream service addresses (internal network only)
KORAUTH_URL=http://korauth:8081
KORVM_URL=http://korvm:8082
KORVOL_URL=http://korvol:8083

# JWKS cache TTL (token validation)
JWKS_CACHE_TTL=10m

# Rate limiting (per tenant/IP, sliding window)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

LOG_LEVEL=info
